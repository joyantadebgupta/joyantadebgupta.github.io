# NOTE: GitHub Pages ignores .htaccess entirely. The enforced policy in production
# is the <meta http-equiv="Content-Security-Policy"> in index.html. Keep this file's
# CSP value in sync with index.html for Apache/self-hosted deployments only.
# Enhanced Security Headers
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header always set X-Frame-Options "DENY"
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"
Header set X-Permitted-Cross-Domain-Policies "none"
# Note: Cross-Origin-Embedder-Policy removed - not supported on GitHub Pages and breaks external resources
Header set Cross-Origin-Opener-Policy "same-origin"
Header set Cross-Origin-Resource-Policy "same-origin"
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; img-src 'self' https: data:; connect-src 'self' https://formspree.io; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; frame-ancestors 'none'; upgrade-insecure-requests;"

# Prevent directory browsing
Options -Indexes

# Redirect www to non-www
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.joyantadebgupta\.github\.io [NC]
RewriteRule ^(.*)$ https://joyantadebgupta.github.io/$1 [L,R=301]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://joyantadebgupta.github.io/$1 [L,R=301]

# Note: Include directive removed - GitHub Pages does not support .htaccess
# Cache rules are handled by GitHub Pages automatically

# Apache-only note: security.txt is served as a physical file at
# /.well-known/security.txt (canonical) and /security.txt (convenience).

# Error pages
ErrorDocument 404 /404.html

# NOTE: no trailing-slash forcing — GitHub Pages handles URLs natively and a
# blanket extensionless-path rule can loop against extensionless site paths.

# Protection against common vulnerabilities (Apache 2.4 syntax)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# HTTP/2 (only if mod_http2 is available; h2c removed — unencrypted HTTP/2 is discouraged)
# Protocols h2 http/1.1

# NOTE: no Link preload headers — resource hints live in index.html <link> tags,
# which is the single source of truth (avoids header/markup drift).
